# ---------------------------------------------------------------------------
# Session & Conversation Management settings. Copy to .env and adjust.
# ---------------------------------------------------------------------------

# Django
DJANGO_DEBUG=false
DJANGO_SECRET_KEY=change-me
DJANGO_ALLOWED_HOSTS=chat.example.com

# PostgreSQL: chat history (Django ORM) + LangGraph checkpoints
POSTGRES_DB=conversations
POSTGRES_USER=conversations
POSTGRES_PASSWORD=change-me
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5440

# Redis: chat sessions, login sessions, history cache
REDIS_URL=redis://127.0.0.1:6390/0
REDIS_PORT=6390

# 2 / 10  sessions and expiry
CHAT_SESSION_IDLE_SECONDS=1800
CONVERSATION_IDLE_HOURS=24
LOGIN_SESSION_SECONDS=28800

# 3 / 4  history
HISTORY_CACHE_SECONDS=300
HISTORY_CACHE_SIZE=50
MAX_MESSAGE_CHARS=4000
TURN_LOCK_SECONDS=120

# 6 / 9  context window and summaries
MAX_CONTEXT_TOKENS=1200
KEEP_RECENT_MESSAGES=6

# 7 / 9  LLM for rewriting follow-ups and summarising (any OpenAI-compatible server)
LLM_ENABLED=true
LLM_BASE_URL=http://localhost:11434/v1
LLM_MODEL=qwen2.5:1.5b
LLM_API_KEY=not-needed-for-ollama
LLM_TIMEOUT_SECONDS=60

# postgres (production) or memory (tests only)
CHECKPOINTER=postgres
