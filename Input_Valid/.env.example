# ---------------------------------------------------------------------------
# rag-input-security settings. Production defaults; copy to .env and adjust.
# Lists are JSON. Every variable maps to a field in src/input_security/settings.py
# ---------------------------------------------------------------------------

# Steps 1-2  Pydantic: request schema and size
MAX_QUERY_CHARS=4000
MAX_QUERY_BYTES=12000
MAX_BODY_BYTES=32768

# Steps 4-5  fastText language detection + NeMo language policy
LANGUAGE_CHECK_ENABLED=true
FASTTEXT_MODEL_PATH=models/lid.176.ftz
LANGUAGE_MIN_LETTERS=12
ALLOWED_LANGUAGES=["en"]
LANGUAGE_MIN_CONFIDENCE=0.65

# Step 6  Microsoft Presidio
PII_ENABLED=true
PRESIDIO_SPACY_MODEL=en_core_web_lg
PII_SCORE_THRESHOLD=0.4
EMPLOYEE_ID_REGEX='\bEMP[-_]?\d{4,8}\b'

# Step 7  Microsoft Purview (only if your organisation uses Purview DLP)
PURVIEW_ENABLED=false
PURVIEW_TENANT_ID=
PURVIEW_CLIENT_ID=
PURVIEW_CLIENT_SECRET=
PURVIEW_APP_NAME=HR Policy Assistant
PURVIEW_APP_VERSION=1.0
PURVIEW_TIMEOUT_SECONDS=5

# Step 8  LLM Guard prompt injection
PROMPT_INJECTION_ENABLED=true
PROMPT_INJECTION_THRESHOLD=0.92
PROMPT_INJECTION_MATCH_TYPE=chunks

# Step 9  LLM Guard jailbreak (signatures always; zero-shot classifier optional)
JAILBREAK_ENABLED=true
JAILBREAK_CLASSIFIER_ENABLED=false
JAILBREAK_CLASSIFIER_THRESHOLD=0.75

# Step 10  Llama Guard via an OpenAI-compatible server (vLLM in production)
# Development: LLAMA_GUARD_BASE_URL=http://localhost:11434/v1  LLAMA_GUARD_MODEL=llama-guard3:1b-q4_K_M
HARMFUL_CONTENT_ENABLED=true
LLAMA_GUARD_BACKEND=http
LLAMA_GUARD_BASE_URL=http://llama-guard:8000/v1
LLAMA_GUARD_MODEL=meta-llama/Llama-Guard-3-8B
LLAMA_GUARD_API_KEY=
LLAMA_GUARD_TIMEOUT_SECONDS=30

# Step 11  NeMo topic scope
TOPIC_SCOPE_ENABLED=true
TOPIC_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
TOPIC_MIN_SIMILARITY=0.35

# Pipeline
NEMO_TIMEOUT_SECONDS=15
EXPOSE_STEP_DETAILS=false
WARMUP_ON_STARTUP=true
FASTEMBED_CACHE_DIR=models/fastembed
